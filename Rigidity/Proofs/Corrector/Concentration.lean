import Rigidity.Proofs.Corrector.ConcentrationTwoHolds

/-!
# Dario's Proposition 2.17 in every dimension

The concentration inequality for stretched exponential moments of Dario, Proposition 2.17 (which
cites Armstrong and Lin, *Optimal quantitative estimates in stochastic homogenization for elliptic
equations in nondivergence form*, ARMA 225, 2017, Proposition 2.2), on the bond configurations of
`ℤ^d` for every `d ≥ 1`: for `p ∈ [0, 1]`, `β ∈ (0, 2)` and an integrable `X` with `𝕍[X] < ∞`
almost surely,

  `E[exp(|X - E X|^β)] ≤ C E[exp((C 𝕍[X])^{β/(2-β)})]^{(2-β)/β}`,

where `𝕍[X] = Σ_e (X - E[X | F(𝓑_d \ {e})])²` and `C` depends on `p` and `β`. The proof is the one
of `concentrationTwo_holds`: the moment inequality `lintegral_abs_sub_rpow_le_vertSum` and the
expansion `lintegral_exp_rpow_le_of_moments` hold for Bernoulli product measures over any countable
nonempty index set, here the bonds of `ℤ^d`; for `p ∈ {0, 1}` the law is a point mass.
-/

namespace Rigidity.Corrector.GeneralDim

open MeasureTheory LatticeProb.Percolation Rigidity.Probability
open scoped ENNReal

variable {d : ℕ}

/-- The σ-algebra `F(𝓑_d \ {e})` generated by the states of the bonds other than `e`. -/
abbrev bondsExcept (e : Bond d) : MeasurableSpace (Configuration d) :=
  MeasurableSpace.comap (fun (ω : Configuration d) (b : {b : Bond d // b ≠ e}) => ω b) inferInstance

/-- The resampling variance `𝕍[X] = Σ_e (X - X'_e)²` of Dario, Proposition 2.17, with
`X'_e = E[X | F(𝓑_d \ {e})]`. -/
noncomputable def resampleVar (p : unitInterval) (X : Configuration d → ℝ) (ω : Configuration d) :
    ℝ≥0∞ :=
  ∑' e : Bond d, ENNReal.ofReal ((X ω - condExp (bondsExcept e) (latticeBondLaw d p) X ω) ^ 2)

/-- **Dario, Proposition 2.17** (Armstrong and Lin, ARMA 225, 2017, Proposition 2.2), in dimension
`d`: for `β ∈ (0, 2)` there is `C < ∞` such that for every integrable `X` with `𝕍[X] < ∞` almost
surely, `E[exp(|X - E[X]|^β)] ≤ C E[exp((C 𝕍[X])^{β/(2-β)})]^{(2-β)/β}`. -/
def Concentration (d : ℕ) : Prop :=
  ∀ (p : unitInterval) (β : ℝ), 0 < β → β < 2 → ∃ C : ℝ, 0 < C ∧
    ∀ X : Configuration d → ℝ, Integrable X (latticeBondLaw d p) →
      (∀ᵐ ω ∂latticeBondLaw d p, resampleVar p X ω < ∞) →
      ∫⁻ ω, ENNReal.ofReal (Real.exp (|X ω - ∫ ω', X ω' ∂latticeBondLaw d p| ^ β))
          ∂latticeBondLaw d p ≤
        ENNReal.ofReal C * (∫⁻ ω, ENNReal.ofReal
          (Real.exp ((C * (resampleVar p X ω).toReal) ^ (β / (2 - β)))) ∂latticeBondLaw d p) ^
          ((2 - β) / β)

theorem resampleVar_eq_vertSum (p : unitInterval) (X : Configuration d → ℝ) :
    resampleVar p X = vertSum p X := rfl

/-- `𝕍[X]` does not change, almost surely, when `X` is modified on a null set. -/
theorem resampleVar_congr_ae {p : unitInterval} {X Y : Configuration d → ℝ}
    (h : X =ᵐ[latticeBondLaw d p] Y) : resampleVar p X =ᵐ[latticeBondLaw d p] resampleVar p Y := by
  have hc : ∀ e : Bond d, condExp (bondsExcept e) (latticeBondLaw d p) X =ᵐ[latticeBondLaw d p]
      condExp (bondsExcept e) (latticeBondLaw d p) Y := fun e => condExp_congr_ae h
  filter_upwards [ae_all_iff.2 hc, h] with ω hω hXY
  simp only [resampleVar, hω, hXY]

/-- At `p ∈ {0, 1}` the bond law is a point mass. -/
theorem exists_latticeBondLaw_eq_dirac {p : unitInterval} (hp : ¬(0 < (p : ℝ) ∧ (p : ℝ) < 1)) :
    ∃ ω₀ : Configuration d, latticeBondLaw d p = Measure.dirac ω₀ := by
  rcases p.2.1.eq_or_lt with h0 | h0
  · have hp0 : p = 0 := Subtype.ext h0.symm
    subst hp0
    refine ⟨fun _ => false, ?_⟩
    simp only [latticeBondLaw, ProbabilityTheory.bernoulliMeasure_zero, Measure.infinitePi_dirac]
  · have h1 : (p : ℝ) = 1 := by
      by_contra hne
      exact hp ⟨h0, lt_of_le_of_ne p.2.2 hne⟩
    have hp1 : p = 1 := Subtype.ext h1
    subst hp1
    exact ⟨allOpen d, latticeBondLaw_one d⟩

/-- **Dario, Proposition 2.17** (Armstrong and Lin, Proposition 2.2), in every dimension `d ≥ 1`. -/
theorem concentration_holds [NeZero d] : Concentration d := by
  intro p β hβ0 hβ2
  haveI : Nonempty (Bond d) :=
    ⟨bondOfAdjacent (x := (0 : Vertex d)) (y := 0 + LatticeProb.unit 0) ⟨0, Or.inl rfl⟩⟩
  by_cases hp : 0 < (p : ℝ) ∧ (p : ℝ) < 1
  · obtain ⟨hp0, hp1⟩ := hp
    have hc : 0 < min (p : ℝ) (1 - p) := lt_min hp0 (by linarith)
    obtain ⟨C, hC, hbound⟩ := lintegral_exp_rpow_le_of_moments (Ω := Configuration d)
      (K := 3 / min (p : ℝ) (1 - p)) (by positivity) hβ0 hβ2
    refine ⟨C, hC, fun X hX hfin => ?_⟩
    set X' := hX.aestronglyMeasurable.mk X with hX'_def
    have hXX' : X =ᵐ[latticeBondLaw d p] X' := hX.aestronglyMeasurable.ae_eq_mk
    have hX'm : Measurable X' := hX.aestronglyMeasurable.stronglyMeasurable_mk.measurable
    have hX'i : Integrable X' (latticeBondLaw d p) := hX.congr hXX'
    have hres := resampleVar_congr_ae hXX'
    have hfin' : ∀ᵐ ω ∂(bernProd (Bond d) p), vertSum p X' ω < ⊤ := by
      filter_upwards [hfin, hres] with ω h1 h2
      rw [← resampleVar_eq_vertSum, ← h2]
      exact h1
    have hint : ∫ ω, X ω ∂(latticeBondLaw d p) = ∫ ω, X' ω ∂(latticeBondLaw d p) :=
      integral_congr_ae hXX'
    have hL : ∫⁻ ω, ENNReal.ofReal (Real.exp (|X ω - ∫ ω', X ω' ∂latticeBondLaw d p| ^ β))
        ∂latticeBondLaw d p =
        ∫⁻ ω, ENNReal.ofReal (Real.exp (|X' ω - ∫ ω', X' ω' ∂latticeBondLaw d p| ^ β))
          ∂latticeBondLaw d p := by
      refine lintegral_congr_ae ?_
      filter_upwards [hXX'] with ω h
      rw [h, hint]
    have hR : ∫⁻ ω, ENNReal.ofReal (Real.exp ((C * (resampleVar p X ω).toReal) ^ (β / (2 - β))))
        ∂latticeBondLaw d p =
        ∫⁻ ω, ENNReal.ofReal (Real.exp ((C * (vertSum p X' ω).toReal) ^ (β / (2 - β))))
          ∂latticeBondLaw d p := by
      refine lintegral_congr_ae ?_
      filter_upwards [hres] with ω h
      rw [h, resampleVar_eq_vertSum]
    rw [hL, hR]
    exact hbound (latticeBondLaw d p) (fun ω => X' ω - ∫ ω', X' ω' ∂latticeBondLaw d p)
      (fun ω => (vertSum p X' ω).toReal) (hX'm.sub measurable_const).aemeasurable
      (measurable_vertSum p hX'm).ennreal_toReal.aemeasurable
      (fun ω => ENNReal.toReal_nonneg)
      (fun q hq => lintegral_abs_sub_rpow_le_vertSum p hp0 hp1 hX'm hX'i hfin' hq)
  · obtain ⟨ω₀, hω₀⟩ := exists_latticeBondLaw_eq_dirac (d := d) hp
    refine ⟨1, one_pos, fun X _ _ => ?_⟩
    rw [hω₀, integral_dirac, lintegral_dirac, lintegral_dirac, sub_self, abs_zero,
      Real.zero_rpow hβ0.ne', Real.exp_zero, ENNReal.ofReal_one, one_mul]
    have h1 : 1 ≤ ENNReal.ofReal (Real.exp ((1 * (resampleVar p X ω₀).toReal) ^ (β / (2 - β)))) :=
      ENNReal.one_le_ofReal.2 (Real.one_le_exp (Real.rpow_nonneg (by
        rw [one_mul]; exact ENNReal.toReal_nonneg) _))
    calc (1 : ENNReal) = 1 ^ ((2 - β) / β) := (ENNReal.one_rpow _).symm
      _ ≤ _ := ENNReal.rpow_le_rpow h1 (div_nonneg (by linarith) hβ0.le)

/-- In dimension two, `Concentration 2` is the planar input `ConcentrationTwo`. -/
theorem concentration_two_iff : Concentration 2 ↔ Rigidity.Corrector.ConcentrationTwo := Iff.rfl

end Rigidity.Corrector.GeneralDim
