import Rigidity.Proofs.Corrector.PlanarHeatSmoothing

/-!
# Dario's Proposition 3.1 from Lemmas 3.2 and 3.3 and the concentration inequality

Dario proves Proposition 3.1, `|Φ_{r²} * ∇[χ_p]_𝒫(x)| ≤ O_s(C |p| r^{-d/2})`, by applying the
concentration inequality of Proposition 2.17 (Armstrong and Lin, ARMA 225, 2017, Proposition 2.2) to
`X = Φ_{r²} * ∇[χ_p]_𝒫(0)`, with the bound `|E[X]| ≤ C r^{-d/2}` of Lemma 3.2 and the bound
`𝕍[X] ≤ O_s(C r^{-d})` of Lemma 3.3. In dimension two, for the coarsened correctors
`coarseField` and the components `heatComp u r x j = Σ_y Φ(r², x, y) (u(y + e_j) - u(y))`:

* `ConcentrationTwo`: Proposition 2.17 (proved as `concentrationTwo_holds`), for integrable `X` with
  `𝕍[X] < ∞` almost surely, where `resampleVar p X = Σ_e (X - E[X | F(𝓑_d \ {e})])²`;
* `DarioLemmaThreeTwo`, `DarioLemmaThreeThree`: Lemmas 3.2 and 3.3 (hypotheses), at every point
  `x`; Dario states them at `x = 0` and reduces to it by stationarity, which for the partition
  `𝒫` (not stationary) amounts to the same lemmas for the translated partitions;
* `lintegral_abs_sub_integral_rpow_le`: the concentration inequality and `𝕍[X] ≤ O_s(θ)` bound
  the moments of `|X - E[X]|` by `(A √θ q^{(1+s)/(2s)})^q`, with `β = 2s/(1+s)`;
* `darioPropThreeOneTwo_of_lemmas`: Proposition 3.1 (`DarioPropThreeOneTwo`) from these and R3,
  which gives the integrability of `X` (`heatGradient_coarseField_isOsBond`);
* `darioOptimalCorrectorTwo_of_lemmas`: Dario's Theorem 1 in dimension two from R2, R3, the
  multiscale Poincaré inequality, the concentration inequality and Lemmas 3.2 and 3.3.
-/

namespace Rigidity.Corrector

open MeasureTheory Filter Set LatticeProb.Percolation Rigidity.Percolation Rigidity.External
open scoped Classical ENNReal

/-- The `j`-th component `Σ_y Φ(r², x, y) (u(y + e_j) - u(y))` of `Φ_{r²} * ∇u(x)`. -/
noncomputable def heatComp (u : Vertex 2 → ℝ) (r : ℝ) (x : Vertex 2) (j : Fin 2) : ℝ :=
  ∑' y, latticeHeat (r ^ 2) x y * (u (y + LatticeProb.unit j) - u y)

theorem heatGradient_eq_sum_abs_heatComp (u : Vertex 2 → ℝ) (r : ℝ) (x : Vertex 2) :
    heatGradient u r x = ∑ j : Fin 2, |heatComp u r x j| := rfl

theorem abs_heatComp_le_heatGradient (u : Vertex 2 → ℝ) (r : ℝ) (x : Vertex 2) (j : Fin 2) :
    |heatComp u r x j| ≤ heatGradient u r x := by
  rw [heatGradient_eq_sum_abs_heatComp]
  exact Finset.single_le_sum (f := fun j => |heatComp u r x j|) (fun j _ => abs_nonneg _)
    (Finset.mem_univ j)

theorem measurable_heatComp {F : Vertex 2 → Configuration 2 → ℝ} (hF : ∀ z, Measurable (F z))
    (r : ℝ) (x : Vertex 2) (j : Fin 2) : Measurable fun ω => heatComp (fun z => F z ω) r x j := by
  unfold heatComp
  exact Measurable.tsum fun y => ((hF _).sub (hF y)).const_mul _

/-- The σ-algebra `F(𝓑_d \ {e})` generated by the states of the bonds other than `e`. -/
abbrev bondsExcept (e : Bond 2) : MeasurableSpace (Configuration 2) :=
  MeasurableSpace.comap (fun (ω : Configuration 2) (b : {b : Bond 2 // b ≠ e}) => ω b) inferInstance

/-- The resampling variance `𝕍[X] = Σ_e (X - X'_e)²` of Dario, Proposition 2.17, with
`X'_e = E[X | F(𝓑_d \ {e})]`. -/
noncomputable def resampleVar (p : unitInterval) (X : Configuration 2 → ℝ) (ω : Configuration 2) :
    ℝ≥0∞ :=
  ∑' e : Bond 2, ENNReal.ofReal ((X ω - condExp (bondsExcept e) (latticeBondLaw 2 p) X ω) ^ 2)

/-- **Dario, Proposition 2.17** (Armstrong and Lin, ARMA 225, 2017, Proposition 2.2; proved as `concentrationTwo_holds`):
for `β ∈ (0, 2)` there is `C(d, β) < ∞` such that for every random variable `X`,
`E[exp(|X - E[X]|^β)] ≤ C E[exp((C 𝕍[X])^{β/(2-β)})]^{(2-β)/β}`; here for integrable `X` with
`𝕍[X] < ∞` almost surely. -/
def ConcentrationTwo : Prop :=
  ∀ (p : unitInterval) (β : ℝ), 0 < β → β < 2 → ∃ C : ℝ, 0 < C ∧
    ∀ X : Configuration 2 → ℝ, Integrable X (latticeBondLaw 2 p) →
      (∀ᵐ ω ∂latticeBondLaw 2 p, resampleVar p X ω < ∞) →
      ∫⁻ ω, ENNReal.ofReal (Real.exp (|X ω - ∫ ω', X ω' ∂latticeBondLaw 2 p| ^ β))
          ∂latticeBondLaw 2 p ≤
        ENNReal.ofReal C * (∫⁻ ω, ENNReal.ofReal
          (Real.exp ((C * (resampleVar p X ω).toReal) ^ (β / (2 - β)))) ∂latticeBondLaw 2 p) ^
          ((2 - β) / β)

/-- **Dario, Lemma 3.2 in dimension two** (hypothesis; its proof uses (3.3), whose proof is
sketched in the source): `|E[Φ_{r²} * ∇_j[χ_{e_i}]_𝒫(x)]| ≤ C/r` for `r ≥ 1`. -/
def DarioLemmaThreeTwo : Prop :=
  ∀ p : unitInterval, criticalProbability 2 < (p : ℝ) → (p : ℝ) < 1 →
    ∀ (G : Set (Configuration 2)) (hG : MeasurableSet G) (hGv : G ⊆ correctorValidEvent 2),
      (∀ᵐ ω ∂latticeBondLaw 2 p, ω ∈ G) → ∃ C : ℝ, 0 < C ∧
        ∀ (i j : Fin 2) (r : ℝ), 1 ≤ r → ∀ x : Vertex 2,
          |∫ ω, heatComp (fun z => coarseField hG hGv i 0 z ω) r x j ∂latticeBondLaw 2 p| ≤ C / r

/-- **Dario, Lemma 3.3 in dimension two** (hypothesis; its proof uses Lemma 3.5, whose proof is
sketched in the source, and Propositions 2.11-2.15, 3.6 and Lemma 3.7):
`𝕍[Φ_{r²} * ∇_j[χ_{e_i}]_𝒫(x)] ≤ O_s(C/r²)` for `r ≥ 1`. -/
def DarioLemmaThreeThree : Prop :=
  ∀ p : unitInterval, criticalProbability 2 < (p : ℝ) → (p : ℝ) < 1 →
    ∀ (G : Set (Configuration 2)) (hG : MeasurableSet G) (hGv : G ⊆ correctorValidEvent 2),
      (∀ᵐ ω ∂latticeBondLaw 2 p, ω ∈ G) → ∃ s C : ℝ, 0 < s ∧ 0 < C ∧
        ∀ (i j : Fin 2) (r : ℝ), 1 ≤ r → ∀ x : Vertex 2,
          (∀ᵐ ω ∂latticeBondLaw 2 p, resampleVar p
            (fun ω => heatComp (fun z => coarseField hG hGv i 0 z ω) r x j) ω < ∞) ∧
          IsOsBond 2 p (fun ω => (resampleVar p
            (fun ω => heatComp (fun z => coarseField hG hGv i 0 z ω) r x j) ω).toReal) s
            (C / r ^ 2)

section Concentration

variable (p : unitInterval)

/-- `𝕍[c X] = c² 𝕍[X]` almost surely, by the linearity of the conditional expectations. -/
theorem ae_resampleVar_const_mul (X : Configuration 2 → ℝ) (c : ℝ) :
    ∀ᵐ ω ∂latticeBondLaw 2 p, resampleVar p (fun ω => c * X ω) ω =
      ENNReal.ofReal (c ^ 2) * resampleVar p X ω := by
  have h : ∀ e : Bond 2, condExp (bondsExcept e) (latticeBondLaw 2 p) (fun ω => c * X ω)
      =ᵐ[latticeBondLaw 2 p] fun ω => c * condExp (bondsExcept e) (latticeBondLaw 2 p) X ω := by
    intro e
    have hcX : (fun ω => c * X ω) = c • X := by
      funext ω
      rw [Pi.smul_apply, smul_eq_mul]
    rw [hcX]
    filter_upwards [condExp_smul (μ := latticeBondLaw 2 p) c X (bondsExcept e)] with ω hω
    rw [hω, Pi.smul_apply, smul_eq_mul]
  filter_upwards [ae_all_iff.2 h] with ω hω
  dsimp only [resampleVar]
  rw [← ENNReal.tsum_mul_left]
  refine tsum_congr fun e => ?_
  rw [hω e, ← mul_sub, mul_pow, ENNReal.ofReal_mul (sq_nonneg c)]

/-- **The moments of `X - E[X]` from the concentration inequality**: if `𝕍[X] ≤ O_s(θ)`, then
`E[|X - E[X]|^q] ≤ (A √θ q^{(1+s)/(2s)})^q` for `q ≥ 1`, with `A` depending on `s` only. -/
theorem lintegral_abs_sub_integral_rpow_le (hconc : ConcentrationTwo) {s : ℝ} (hs : 0 < s) :
    ∃ A : ℝ, 0 < A ∧ ∀ (X : Configuration 2 → ℝ) (θ : ℝ), 0 < θ →
      Integrable X (latticeBondLaw 2 p) →
      (∀ᵐ ω ∂latticeBondLaw 2 p, resampleVar p X ω < ∞) →
      IsOsBond 2 p (fun ω => (resampleVar p X ω).toReal) s θ →
      ∀ q : ℝ, 1 ≤ q → ∫⁻ ω, ENNReal.ofReal (|X ω - ∫ ω', X ω' ∂latticeBondLaw 2 p| ^ q)
          ∂latticeBondLaw 2 p ≤
        ENNReal.ofReal ((A * Real.sqrt θ * q ^ ((1 + s) / (2 * s))) ^ q) := by
  set β : ℝ := 2 * s / (1 + s) with hβ
  have hβ0 : 0 < β := by positivity
  have hβ' : β * (1 + s) = 2 * s := by rw [hβ]; exact div_mul_cancel₀ _ (by positivity)
  have hβ2 : β < 2 := by nlinarith
  have hβs : β / (2 - β) = s := by
    rw [div_eq_iff (sub_pos.2 hβ2).ne']
    linear_combination hβ'
  have hβi : (2 - β) / β = 1 / s := by
    rw [div_eq_div_iff hβ0.ne' hs.ne']
    linear_combination -hβ'
  have hβk : (1 + s) / (2 * s) = 1 / β := by
    rw [div_eq_div_iff (by positivity) hβ0.ne']
    linear_combination hβ'
  obtain ⟨Cc, hCc, hc⟩ := hconc p β hβ0 hβ2
  refine ⟨Real.sqrt Cc / β ^ (1 / β) * max 1 (Cc * 2 ^ (1 / s)), by positivity,
    fun X θ hθ hXi hXV hXO q hq => ?_⟩
  have hq0 : 0 < q := by linarith
  set L : ℝ := Real.sqrt (Cc * θ) with hL
  have hL0 : 0 < L := Real.sqrt_pos.2 (by positivity)
  have hLsq : L⁻¹ ^ 2 = (Cc * θ)⁻¹ := by
    rw [inv_pow, hL, Real.sq_sqrt (by positivity)]
  -- the rescaled variable `Y = X / L`
  have hYi : Integrable (fun ω => L⁻¹ * X ω) (latticeBondLaw 2 p) := hXi.const_mul L⁻¹
  have hV := ae_resampleVar_const_mul p X L⁻¹
  have hYV : ∀ᵐ ω ∂latticeBondLaw 2 p, resampleVar p (fun ω => L⁻¹ * X ω) ω < ∞ := by
    filter_upwards [hV, hXV] with ω hω h'
    rw [hω]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top h'
  have h := hc (fun ω => L⁻¹ * X ω) hYi hYV
  -- the right-hand side
  have hrhs : ∫⁻ ω, ENNReal.ofReal (Real.exp ((Cc * (resampleVar p
      (fun ω => L⁻¹ * X ω) ω).toReal) ^ (β / (2 - β)))) ∂latticeBondLaw 2 p ≤ ENNReal.ofReal 2 := by
    have hcongr : ∀ᵐ ω ∂latticeBondLaw 2 p, ENNReal.ofReal (Real.exp ((Cc * (resampleVar p
        (fun ω => L⁻¹ * X ω) ω).toReal) ^ (β / (2 - β)))) =
        ENNReal.ofReal (Real.exp (Real.rpow (max ((resampleVar p X ω).toReal / θ) 0) s)) := by
      filter_upwards [hV] with ω hω
      rw [hω, ENNReal.toReal_mul, ENNReal.toReal_ofReal (sq_nonneg _), hLsq, hβs,
        max_eq_left (div_nonneg ENNReal.toReal_nonneg hθ.le), Real.rpow_eq_pow]
      congr 3
      rw [mul_inv, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hCc.ne', one_mul, div_eq_inv_mul]
    rw [lintegral_congr_ae hcongr, ← ofReal_integral_eq_lintegral_ofReal hXO.1
      (Eventually.of_forall fun ω => (Real.exp_pos _).le)]
    exact ENNReal.ofReal_le_ofReal hXO.2
  have hexp : ∫⁻ ω, ENNReal.ofReal (Real.exp (|L⁻¹ * X ω - ∫ ω', L⁻¹ * X ω' ∂latticeBondLaw 2 p|
      ^ β)) ∂latticeBondLaw 2 p ≤ ENNReal.ofReal (Cc * 2 ^ (1 / s)) := by
    refine h.trans ?_
    calc ENNReal.ofReal Cc * (∫⁻ ω, ENNReal.ofReal (Real.exp ((Cc * (resampleVar p
          (fun ω => L⁻¹ * X ω) ω).toReal) ^ (β / (2 - β)))) ∂latticeBondLaw 2 p) ^ ((2 - β) / β)
        ≤ ENNReal.ofReal Cc * ENNReal.ofReal 2 ^ ((2 - β) / β) :=
          mul_le_mul_right (ENNReal.rpow_le_rpow hrhs (by rw [hβi]; positivity)) _
      _ = ENNReal.ofReal (Cc * 2 ^ (1 / s)) := by
          rw [hβi, ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity),
            ← ENNReal.ofReal_mul hCc.le]
  -- the pointwise bound
  have hpt : ∀ ω, |X ω - ∫ ω', X ω' ∂latticeBondLaw 2 p| ^ q ≤
      L ^ q * (q / β) ^ (q / β) * Real.exp (|L⁻¹ * X ω - ∫ ω', L⁻¹ * X ω' ∂latticeBondLaw 2 p|
        ^ β) := by
    intro ω
    set a := |L⁻¹ * X ω - ∫ ω', L⁻¹ * X ω' ∂latticeBondLaw 2 p| with ha
    have ha0 : 0 ≤ a := abs_nonneg _
    have hXa : |X ω - ∫ ω', X ω' ∂latticeBondLaw 2 p| = L * a := by
      rw [ha, integral_const_mul, ← mul_sub, abs_mul, abs_of_pos (inv_pos.2 hL0), ← mul_assoc,
        mul_inv_cancel₀ hL0.ne', one_mul]
    have hqβ : β * (q / β) = q := by field_simp
    have haq : a ^ q = (a ^ β) ^ (q / β) := by
      rw [← Real.rpow_mul ha0, hqβ]
    have hb := rpow_le_rpow_mul_exp (Real.rpow_nonneg ha0 β) (div_pos hq0 hβ0)
    have he : Real.exp (-(q / β)) ≤ 1 := Real.exp_le_one_iff.2 (by linarith [div_pos hq0 hβ0])
    rw [hXa, Real.mul_rpow hL0.le ha0, haq, mul_assoc]
    refine mul_le_mul_of_nonneg_left (hb.trans ?_) (by positivity)
    calc (q / β) ^ (q / β) * Real.exp (-(q / β)) * Real.exp (a ^ β)
        ≤ (q / β) ^ (q / β) * 1 * Real.exp (a ^ β) := by gcongr
      _ = (q / β) ^ (q / β) * Real.exp (a ^ β) := by rw [mul_one]
  have hint : ∫⁻ ω, ENNReal.ofReal (|X ω - ∫ ω', X ω' ∂latticeBondLaw 2 p| ^ q)
      ∂latticeBondLaw 2 p ≤ ENNReal.ofReal (L ^ q * (q / β) ^ (q / β) * (Cc * 2 ^ (1 / s))) := by
    calc ∫⁻ ω, ENNReal.ofReal (|X ω - ∫ ω', X ω' ∂latticeBondLaw 2 p| ^ q) ∂latticeBondLaw 2 p
        ≤ ∫⁻ ω, ENNReal.ofReal (L ^ q * (q / β) ^ (q / β)) * ENNReal.ofReal (Real.exp
            (|L⁻¹ * X ω - ∫ ω', L⁻¹ * X ω' ∂latticeBondLaw 2 p| ^ β)) ∂latticeBondLaw 2 p := by
          refine lintegral_mono fun ω => ?_
          rw [← ENNReal.ofReal_mul (by positivity)]
          exact ENNReal.ofReal_le_ofReal (hpt ω)
      _ = ENNReal.ofReal (L ^ q * (q / β) ^ (q / β)) * ∫⁻ ω, ENNReal.ofReal (Real.exp
            (|L⁻¹ * X ω - ∫ ω', L⁻¹ * X ω' ∂latticeBondLaw 2 p| ^ β)) ∂latticeBondLaw 2 p :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (L ^ q * (q / β) ^ (q / β)) * ENNReal.ofReal (Cc * 2 ^ (1 / s)) :=
          mul_le_mul_right hexp _
      _ = ENNReal.ofReal (L ^ q * (q / β) ^ (q / β) * (Cc * 2 ^ (1 / s))) :=
          (ENNReal.ofReal_mul (by positivity)).symm
  refine hint.trans (ENNReal.ofReal_le_ofReal ?_)
  -- the constants
  have hM : Cc * 2 ^ (1 / s) ≤ max 1 (Cc * 2 ^ (1 / s)) ^ q :=
    (le_max_right 1 _).trans ((Real.rpow_one _).symm.le.trans
      (Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hq))
  have hqb : (q / β) ^ (q / β) = (q ^ (1 / β) / β ^ (1 / β)) ^ q := by
    rw [← Real.div_rpow hq0.le hβ0.le, ← Real.rpow_mul (div_nonneg hq0.le hβ0.le),
      one_div_mul_eq_div]
  rw [hβk, hqb, hL, Real.sqrt_mul hCc.le]
  calc (Real.sqrt Cc * Real.sqrt θ) ^ q * (q ^ (1 / β) / β ^ (1 / β)) ^ q * (Cc * 2 ^ (1 / s))
      ≤ (Real.sqrt Cc * Real.sqrt θ) ^ q * (q ^ (1 / β) / β ^ (1 / β)) ^ q *
          max 1 (Cc * 2 ^ (1 / s)) ^ q :=
        mul_le_mul_of_nonneg_left hM (by positivity)
    _ = (Real.sqrt Cc / β ^ (1 / β) * max 1 (Cc * 2 ^ (1 / s)) * Real.sqrt θ * q ^ (1 / β)) ^ q := by
        rw [← Real.mul_rpow (by positivity) (by positivity),
          ← Real.mul_rpow (by positivity) (by positivity)]
        congr 1
        ring

end Concentration

/-- `r X ≤ O_s(C)` gives `X ≤ O_s(C/r)`. -/
theorem isOsBond_div_of_mul {p : unitInterval} {X : Configuration 2 → ℝ} {s C r : ℝ}
    (h : IsOsBond 2 p (fun ω => r * X ω) s C) : IsOsBond 2 p X s (C / r) := by
  have e : ∀ ω, X ω / (C / r) = r * X ω / C := fun ω => by
    rw [div_div_eq_mul_div, mul_comm (X ω) r]
  unfold IsOsBond at h ⊢
  simp only [e]
  exact h

/-- `∫ (c + (g + h))^q ≤ 4^q M` when `c^q`, `∫ g^q` and `∫ h^q` are at most `M`. -/
theorem lintegral_const_add_add_rpow_le {p : unitInterval} {g h : Configuration 2 → ℝ≥0∞}
    (hg : Measurable g) {q : ℝ} (hq : 1 ≤ q) {c M : ℝ≥0∞} (hc : c ^ q ≤ M)
    (hgM : ∫⁻ ω, g ω ^ q ∂latticeBondLaw 2 p ≤ M) (hhM : ∫⁻ ω, h ω ^ q ∂latticeBondLaw 2 p ≤ M) :
    ∫⁻ ω, (c + (g ω + h ω)) ^ q ∂latticeBondLaw 2 p ≤ 4 ^ q * M := by
  have hq0 : 0 ≤ q - 1 := by linarith
  have h2 : (2 : ℝ≥0∞) ^ (q - 1) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg hq0 ENNReal.ofNat_ne_top
  calc ∫⁻ ω, (c + (g ω + h ω)) ^ q ∂latticeBondLaw 2 p
      ≤ ∫⁻ ω, 2 ^ (q - 1) * (c ^ q + 2 ^ (q - 1) * (g ω ^ q + h ω ^ q)) ∂latticeBondLaw 2 p := by
        refine lintegral_mono fun ω => (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq).trans ?_
        exact mul_le_mul_right (add_le_add le_rfl
          (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)) _
    _ = 2 ^ (q - 1) * (c ^ q + 2 ^ (q - 1) * (∫⁻ ω, g ω ^ q ∂latticeBondLaw 2 p +
          ∫⁻ ω, h ω ^ q ∂latticeBondLaw 2 p)) := by
        rw [lintegral_const_mul' _ _ h2, lintegral_add_left measurable_const, lintegral_const,
          measure_univ, mul_one, lintegral_const_mul' _ _ h2,
          lintegral_add_left (hg.pow_const q)]
    _ ≤ 2 ^ (q - 1) * (M + 2 ^ (q - 1) * (M + M)) :=
        mul_le_mul_right (add_le_add hc (mul_le_mul_right (add_le_add hgM hhM) _)) _
    _ ≤ 4 ^ q * M := by
        have e4 : (4 : ℝ≥0∞) ^ q = 2 ^ q * 2 ^ q := by
          rw [← ENNReal.mul_rpow_of_nonneg _ _ (by linarith)]
          norm_num
        have h1 : (1 : ℝ≥0∞) ≤ 2 ^ q := ENNReal.one_le_rpow (by norm_num) (by linarith)
        rw [← two_mul M, ← mul_assoc (2 ^ (q - 1)) 2, two_rpow_sub_one_mul_two hq, e4]
        calc 2 ^ (q - 1) * (M + 2 ^ q * M)
            ≤ 2 ^ (q - 1) * (2 ^ q * M + 2 ^ q * M) :=
              mul_le_mul_right (add_le_add (le_mul_of_one_le_left zero_le h1) le_rfl) _
          _ = 2 ^ q * 2 ^ q * M := by
              rw [← two_mul, ← mul_assoc, ← mul_assoc, two_rpow_sub_one_mul_two hq]

/-- **Dario, Proposition 3.1 in dimension two**, from R3, the concentration inequality
(Proposition 2.17) and Lemmas 3.2 and 3.3, as in the source: `|X| ≤ |E[X]| + |X - E[X]|`
componentwise, the second term bounded through the concentration inequality. -/
theorem darioPropThreeOneTwo_of_lemmas (hR3 : ArmstrongDarioOrderZeroTwo)
    (hconc : ConcentrationTwo) (h32 : DarioLemmaThreeTwo) (h33 : DarioLemmaThreeThree) :
    DarioPropThreeOneTwo := by
  intro p hpc hp1 G hG hGv hGae
  obtain ⟨C₁, hC₁, h1⟩ := h32 p hpc hp1 G hG hGv hGae
  obtain ⟨s, C₂, hs, hC₂, h2⟩ := h33 p hpc hp1 G hG hGv hGae
  obtain ⟨s₀, C₀, hs₀, hC₀, h0⟩ := heatGradient_coarseField_isOsBond hG hGv hR3 hpc hp1 hGae
  obtain ⟨A, hA, hmomX⟩ := lintegral_abs_sub_integral_rpow_le p hconc hs
  have hk : 0 < (1 + s) / (2 * s) := by positivity
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = 2 * C₁ + A * Real.sqrt C₂ := ⟨_, rfl⟩
  have hB0 : 0 < B := by rw [hB]; positivity
  have hs' : 0 < 1 / (2 * ((1 + s) / (2 * s))) := by positivity
  have hsk : 1 / (2 * ((1 + s) / (2 * s))) * ((1 + s) / (2 * s)) < 1 := by
    rw [one_div_mul_eq_div, div_lt_one (by positivity)]
    linarith
  obtain ⟨C, hC, hmom⟩ := isOsBond_of_moment_le (d := 2) (p := p)
    (mul_pos (by norm_num : (0 : ℝ) < 4) hB0) hs' hsk
  refine ⟨_, C, hs', hC, fun i r hr x => ?_⟩
  have hr0 : 0 < r := by linarith
  have hF : ∀ z, Measurable (coarseField hG hGv i 0 z) := fun z => measurable_coarseField hG hGv i 0 z
  have hHm := measurable_heatGradient_const hF r x
  have hXm : ∀ j, Measurable fun ω => heatComp (fun z => coarseField hG hGv i 0 z ω) r x j :=
    fun j => measurable_heatComp hF r x j
  -- integrability of the components
  have hHi : Integrable (fun ω => heatGradient (fun z => coarseField hG hGv i 0 z ω) r x)
      (latticeBondLaw 2 p) := by
    have := (IsOsBond.integral_rpow_le hs₀ hC₀ one_pos hHm (fun ω => heatGradient_nonneg _ _ _)
      (h0 i r x)).1
    simpa only [Real.rpow_one] using this
  have hXi : ∀ j, Integrable (fun ω => heatComp (fun z => coarseField hG hGv i 0 z ω) r x j)
      (latticeBondLaw 2 p) := fun j =>
    hHi.mono' (hXm j).aestronglyMeasurable (Eventually.of_forall fun ω => by
      rw [Real.norm_eq_abs]
      exact abs_heatComp_le_heatGradient _ _ _ _)
  -- the moments of the centred components
  set E : Fin 2 → ℝ := fun j =>
    ∫ ω, heatComp (fun z => coarseField hG hGv i 0 z ω) r x j ∂latticeBondLaw 2 p with hE
  have hmomj : ∀ j (q : ℝ), 1 ≤ q → ∫⁻ ω, ENNReal.ofReal (r * |heatComp
      (fun z => coarseField hG hGv i 0 z ω) r x j - E j|) ^ q ∂latticeBondLaw 2 p ≤
      ENNReal.ofReal ((B * q ^ ((1 + s) / (2 * s))) ^ q) := by
    intro j q hq
    have hq0 : 0 < q := by linarith
    have hθ : 0 < C₂ / r ^ 2 := by positivity
    have h := hmomX _ _ hθ (hXi j) (h2 i j r hr x).1 (h2 i j r hr x).2 q hq
    calc ∫⁻ ω, ENNReal.ofReal (r * |heatComp (fun z => coarseField hG hGv i 0 z ω) r x j - E j|)
          ^ q ∂latticeBondLaw 2 p
        = ∫⁻ ω, ENNReal.ofReal (r ^ q) * ENNReal.ofReal (|heatComp
            (fun z => coarseField hG hGv i 0 z ω) r x j - E j| ^ q) ∂latticeBondLaw 2 p := by
          refine lintegral_congr fun ω => ?_
          rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hq0.le,
            Real.mul_rpow hr0.le (abs_nonneg _), ENNReal.ofReal_mul (by positivity)]
      _ = ENNReal.ofReal (r ^ q) * ∫⁻ ω, ENNReal.ofReal (|heatComp
            (fun z => coarseField hG hGv i 0 z ω) r x j - E j| ^ q) ∂latticeBondLaw 2 p :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (r ^ q) * ENNReal.ofReal
            ((A * Real.sqrt (C₂ / r ^ 2) * q ^ ((1 + s) / (2 * s))) ^ q) :=
          mul_le_mul_right h _
      _ = ENNReal.ofReal ((A * Real.sqrt C₂ * q ^ ((1 + s) / (2 * s))) ^ q) := by
          rw [← ENNReal.ofReal_mul (by positivity), ← Real.mul_rpow hr0.le (by positivity),
            Real.sqrt_div' _ (by positivity), Real.sqrt_sq hr0.le]
          congr 2
          field_simp
      _ ≤ ENNReal.ofReal ((B * q ^ ((1 + s) / (2 * s))) ^ q) := by
          refine ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow (by positivity) ?_ hq0.le)
          exact mul_le_mul_of_nonneg_right (by rw [hB]; linarith) (by positivity)
  -- the pointwise bound
  have hpt : ∀ ω, ENNReal.ofReal (r * heatGradient (fun z => coarseField hG hGv i 0 z ω) r x) ≤
      ENNReal.ofReal (2 * C₁) + (ENNReal.ofReal (r * |heatComp
        (fun z => coarseField hG hGv i 0 z ω) r x 0 - E 0|) + ENNReal.ofReal (r * |heatComp
        (fun z => coarseField hG hGv i 0 z ω) r x 1 - E 1|)) := by
    intro ω
    have hEj : ∀ j, r * |E j| ≤ C₁ := fun j => by
      have := h1 i j r hr x
      rw [le_div_iff₀ hr0, mul_comm] at this
      exact this
    have hj : ∀ j, r * |heatComp (fun z => coarseField hG hGv i 0 z ω) r x j| ≤
        C₁ + r * |heatComp (fun z => coarseField hG hGv i 0 z ω) r x j - E j| := fun j => by
      have h3 := mul_le_mul_of_nonneg_left
        (abs_sub_abs_le_abs_sub (heatComp (fun z => coarseField hG hGv i 0 z ω) r x j) (E j))
        hr0.le
      rw [mul_sub] at h3
      linarith [hEj j]
    rw [← ENNReal.ofReal_add (by positivity) (by positivity),
      ← ENNReal.ofReal_add (by positivity) (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [heatGradient_eq_sum_abs_heatComp, Fin.sum_univ_two, mul_add]
    linarith [hj 0, hj 1]
  refine isOsBond_div_of_mul (isOsBond_of_ae_ofReal_le (by positivity) hmom
    (measurable_const.mul hHm) (fun ω => mul_nonneg hr0.le (heatGradient_nonneg _ _ _))
    (Eventually.of_forall hpt) fun q hq => ?_)
  have hq0 : 0 < q := by linarith
  have hc : ENNReal.ofReal (2 * C₁) ^ q ≤ ENNReal.ofReal ((B * q ^ ((1 + s) / (2 * s))) ^ q) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hq0.le]
    refine ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow (by positivity) ?_ hq0.le)
    have h1q : 1 ≤ q ^ ((1 + s) / (2 * s)) := Real.one_le_rpow hq hk.le
    rw [hB]
    nlinarith [mul_nonneg (mul_nonneg hA.le (Real.sqrt_nonneg C₂)) (zero_le_one.trans h1q),
      mul_le_mul_of_nonneg_left h1q (by positivity : (0 : ℝ) ≤ 2 * C₁)]
  have hgm : ∀ j, Measurable fun ω => ENNReal.ofReal (r * |heatComp
      (fun z => coarseField hG hGv i 0 z ω) r x j - E j|) := fun j =>
    ENNReal.measurable_ofReal.comp (measurable_const.mul ((hXm j).sub measurable_const).abs)
  refine (lintegral_const_add_add_rpow_le (hgm 0) hq hc (hmomj 0 q hq)
    (hmomj 1 q hq)).trans (le_of_eq ?_)
  have h4 : (4 : ℝ≥0∞) ^ q = ENNReal.ofReal (4 ^ q) := by
    rw [← ENNReal.ofReal_rpow_of_nonneg (by norm_num) hq0.le, ENNReal.ofReal_ofNat]
  rw [h4, ← ENNReal.ofReal_mul (by positivity), ← Real.mul_rpow (by norm_num) (by positivity),
    ← mul_assoc]

/-- **Dario's Theorem 1 in dimension two** from R2, R3, the multiscale Poincaré inequality
(Proposition 2.19), the concentration inequality (Proposition 2.17) and Lemmas 3.2 and 3.3. -/
theorem darioOptimalCorrectorTwo_of_lemmas (hR2 : SupercriticalBondCorrectorInputTwo)
    (hR3 : ArmstrongDarioOrderZeroTwo) {A₀ : ℝ} (hA₀ : 0 < A₀) (hMSP : MultiscalePoincareTwo A₀)
    (hconc : ConcentrationTwo) (h32 : DarioLemmaThreeTwo) (h33 : DarioLemmaThreeThree) :
    DarioOptimalCorrectorTwo :=
  darioOptimalCorrectorTwo_of_prop31 hR2 hR3 hA₀ hMSP
    (darioPropThreeOneTwo_of_lemmas hR3 hconc h32 h33)

end Rigidity.Corrector
