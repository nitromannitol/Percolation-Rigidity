/-- The 120 path designs, one for each pair of terminals (found by exhaustive search). -/
def designs : List ((ℤ × ℤ) × (ℤ × ℤ) × List (ℤ × ℤ)) :=
  designs1 ++ designs2 ++ designs3 ++ designs4 ++ designs5 ++ designs6 ++ designs7 ++ designs8

theorem designs_good : ∀ x ∈ designs, GoodDesign x.1 x.2.1 x.2.2 := by decide +kernel

theorem designs_cover : ∀ a ∈ terminalList, ∀ b ∈ terminalList, a ≠ b →
    ∃ x ∈ designs, (x.1 = a ∧ x.2.1 = b) ∨ (x.1 = b ∧ x.2.1 = a) := by decide +kernel

theorem siteList_nbr4 : ∀ a ∈ siteList, ∀ b ∈ nbr4 a, b ∈ siteList ∨ b ∈ terminalList := by
  decide +kernel

theorem terminalList_not_site : ∀ a ∈ terminalList, a ∉ siteList := by decide +kernel

theorem siteList_bound : ∀ a ∈ siteList, |a.1| ≤ 2 ∧ |a.2| ≤ 2 := by decide +kernel

theorem card_terminalList : terminalList.length = 16 := rfl

end Rigidity.Steps.S3
