/-!
# The path designs of the local surgery

The finite data of the local surgery of `Rigidity/Steps/S3/SignedIncrement.lean` (the signed
variant of Proposition 3.2) and its decidable checks: the 21 sites of the surgery region, the
square `Q_2` minus its four corners (`siteList`), its 16 terminals (`terminalList`), and 120 path
designs (`designs`), one for each pair of terminals, each a good design (`designs_good`) and
together joining every pair (`designs_cover`). The checks run in the kernel (`decide +kernel`);
this leaf module imports only the order and group structure of `ℤ`, so they are evaluated once,
off the import chain of the proof file.
-/

namespace Rigidity.Steps.S3

/-- The 21 sites of the square `Q_2` minus its four corners. -/
def siteList : List (ℤ × ℤ) :=
  [(-2, -1), (-2, 0), (-2, 1), (-1, -2), (-1, -1), (-1, 0), (-1, 1), (-1, 2), (0, -2), (0, -1), (0, 0), (0, 1), (0, 2), (1, -2), (1, -1), (1, 0), (1, 1), (1, 2), (2, -1), (2, 0), (2, 1)]

/-- The terminals of the surgery region: the sixteen sites outside it adjacent to it. -/
def terminalList : List (ℤ × ℤ) :=
  [(3, -1), (3, 0), (3, 1), (-3, -1), (-3, 0), (-3, 1), (-1, 3), (0, 3), (1, 3), (-1, -3),
    (0, -3), (1, -3), (2, 2), (2, -2), (-2, 2), (-2, -2)]

/-! ### The path designs -/

/-- The four lattice neighbours of a site of `ℤ²`. -/
def nbr4 (a : ℤ × ℤ) : List (ℤ × ℤ) :=
  [(a.1 + 1, a.2), (a.1 - 1, a.2), (a.1, a.2 + 1), (a.1, a.2 - 1)]

/-- The consecutive pairs of a path. -/
def zipPairs (P : List (ℤ × ℤ)) : List ((ℤ × ℤ) × (ℤ × ℤ)) := P.zip P.tail

/-- The consecutive triples of a path. -/
def triples (P : List (ℤ × ℤ)) : List ((ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ)) :=
  P.zip (P.tail.zip P.tail.tail)

/-- The sites joined to `a` by a bond of the path `P`. -/
def partnersOf (a : ℤ × ℤ) (P : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (zipPairs P).filterMap fun q => if q.1 = a then some q.2 else if q.2 = a then some q.1 else none

/-- A path design from the terminal `t` to the terminal `s`: a self-avoiding lattice path `P` whose
inner sites lie in the surgery region, each inner site joined by the bonds of `P` to its two path
neighbours only, `t` and `s` to one site of the region only, the other terminals to no site; `P`
crosses one horizontal bond to the right and one to the left. -/
def GoodDesign (t s : ℤ × ℤ) (P : List (ℤ × ℤ)) : Prop :=
  P.head? = some t ∧ P.getLast? = some s ∧ t ∈ terminalList ∧ s ∈ terminalList ∧ t ≠ s ∧
    (zipPairs P).length ≤ 12 ∧
    (∀ q ∈ zipPairs P, q.2 ∈ nbr4 q.1 ∧ (q.1 ∈ siteList ∨ q.2 ∈ siteList)) ∧
    (∀ y ∈ triples P, y.2.1 ∈ siteList ∧ y.1 ≠ y.2.2 ∧ partnersOf y.2.1 P = [y.1, y.2.2] ∧
      (y.1, y.2.1) ∈ zipPairs P ∧ (y.2.1, y.2.2) ∈ zipPairs P) ∧
    (∃ q ∈ zipPairs P, q.1 = t ∧ partnersOf t P = [q.2] ∧ q.2 ∈ siteList) ∧
    (∃ q ∈ zipPairs P, q.2 = s ∧ partnersOf s P = [q.1] ∧ q.1 ∈ siteList) ∧
    (∀ r ∈ terminalList, r ≠ t → r ≠ s → partnersOf r P = []) ∧
    (∃ q ∈ zipPairs P, q.2 = (q.1.1 + 1, q.1.2)) ∧ (∃ q ∈ zipPairs P, q.2 = (q.1.1 - 1, q.1.2))

instance (t s : ℤ × ℤ) (P : List (ℤ × ℤ)) : Decidable (GoodDesign t s P) := by
  unfold GoodDesign
  repeat' refine @instDecidableAnd _ _ ?_ ?_
  all_goals infer_instance

