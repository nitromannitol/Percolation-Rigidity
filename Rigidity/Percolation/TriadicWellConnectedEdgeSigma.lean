import Rigidity.Percolation.TriadicWellConnectedSigma

/-!
# Local edge measurability of good cubes

On a finite vertex region, the sigma algebra generated by its induced open
graph is generated by the individual edge events in that region.
-/

namespace Rigidity.Percolation

open LatticeProb.Percolation MeasureTheory

/-- The sigma algebra generated by open adjacency events inside a region. -/
abbrev localEdgeSigma {d : ℕ} (U : Set (Vertex d)) : MeasurableSpace (Configuration d) :=
  MeasurableSpace.generateFrom {E | ∃ x ∈ U, ∃ y ∈ U,
    E = {ω | (openGraph ω).Adj x y}}

/-- On a finite region, every event determined by the induced graph belongs to
the sigma algebra generated by its edge events. -/
theorem localGraphSigma_le_localEdgeSigma {d : ℕ} (U : Set (Vertex d))
    (hU : U.Finite) : localGraphSigma U ≤ localEdgeSigma U := by
  classical
  let V := {x : Vertex d // x ∈ U}
  letI : Finite V := hU
  letI : Fintype V := Fintype.ofFinite V
  letI : Finite (SimpleGraph V) := Finite.of_injective SimpleGraph.Adj
    (fun _ _ h => SimpleGraph.ext h)
  intro E hE
  obtain ⟨T, _, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hE
  have hadj (x y : V) : MeasurableSet[localEdgeSigma U]
      {ω : Configuration d | (openGraph ω).Adj x y} :=
    MeasurableSpace.measurableSet_generateFrom ⟨x, x.property, y, y.property, rfl⟩
  have hgraph (G : SimpleGraph V) : MeasurableSet[localEdgeSigma U]
      {ω : Configuration d | (openGraph ω).induce U = G} := by
    have heq : {ω : Configuration d | (openGraph ω).induce U = G} =
        ⋂ x : V, ⋂ y : V, {ω | (openGraph ω).Adj x y ↔ G.Adj x y} := by
      ext ω
      simp only [Set.mem_setOf_eq, Set.mem_iInter]
      constructor
      · intro h x y
        rw [← h]
        rfl
      · intro h
        ext x y
        exact h x y
    rw [heq]
    refine MeasurableSet.iInter fun x => MeasurableSet.iInter fun y => ?_
    by_cases h : G.Adj x y
    · simpa only [h, iff_true] using hadj x y
    · simpa only [h, iff_false, Set.compl_setOf] using (hadj x y).compl
  have heq : (fun ω : Configuration d => (openGraph ω).induce U) ⁻¹' T =
      ⋃ G : SimpleGraph V, ⋃ (_ : G ∈ T),
        {ω : Configuration d | (openGraph ω).induce U = G} := by
    ext ω
    simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_setOf_eq]
    constructor
    · intro h
      exact ⟨_, h, rfl⟩
    · rintro ⟨G, hG, heq⟩
      simpa only [heq] using hG
  rw [heq]
  exact MeasurableSet.iUnion fun G => MeasurableSet.iUnion fun _ => hgraph G

/-- Every local edge event is determined by the induced graph. -/
theorem localEdgeSigma_le_localGraphSigma {d : ℕ} (U : Set (Vertex d)) :
    localEdgeSigma U ≤ localGraphSigma U := by
  apply MeasurableSpace.generateFrom_le
  rintro E ⟨x, hx, y, hy, rfl⟩
  apply MeasurableSpace.measurableSet_comap.mpr
  exact ⟨{G | G.Adj ⟨x, hx⟩ ⟨y, hy⟩}, trivial, rfl⟩

/-- The local graph and edge sigma algebras agree for a finite region. -/
theorem localGraphSigma_eq_localEdgeSigma {d : ℕ} (U : Set (Vertex d))
    (hU : U.Finite) : localGraphSigma U = localEdgeSigma U :=
  le_antisymm (localGraphSigma_le_localEdgeSigma U hU) (localEdgeSigma_le_localGraphSigma U)

/-- A good-cube event is measurable with respect to edge events in its
concentric threefold enlargement. -/
theorem TriadicCube.measurableSet_goodOfWellConnected_localEdge {d : ℕ}
    (Q : TriadicCube d) (interior : TriadicCube d → Set (Vertex d))
    (hinterior : ∀ R, interior R ⊆ R.vertices) :
    MeasurableSet[localEdgeSigma Q.centeredTriple]
      {ω | Q ∈ goodOfWellConnected (wellConnectedFamily interior ω)} :=
  localGraphSigma_le_localEdgeSigma Q.centeredTriple Q.finite_centeredTriple _
    (Q.measurableSet_goodOfWellConnected_localGraph interior hinterior)

end Rigidity.Percolation
