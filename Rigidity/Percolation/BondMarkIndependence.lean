import Rigidity.Percolation.BondMarkThreshold

/-!
# Independent families of uniform bond marks

Disjoint bond sets generate independent sigma algebras. Thresholding marks
uses only the marks at the corresponding bond coordinates.
-/

namespace Rigidity.Percolation

open LatticeProb.Percolation MeasureTheory ProbabilityTheory
open scoped unitInterval

/-- The sigma algebra generated by marks at a specified set of bonds. -/
abbrev bondMarkSigma {d : ℕ} (E : Set (Bond d)) : MeasurableSpace (BondMarks d) :=
  ⨆ e ∈ E, MeasurableSpace.comap (fun ω : BondMarks d => ω e) inferInstance

/-- Every mark-coordinate sigma algebra lies in the full product sigma algebra. -/
theorem bondMarkSigma_le {d : ℕ} (E : Set (Bond d)) :
    bondMarkSigma E ≤ (inferInstance : MeasurableSpace (BondMarks d)) :=
  iSup₂_le fun e _ => (measurable_pi_apply e).comap_le

/-- Disjoint families of bond marks are independent. -/
theorem indep_bondMarkSigma {d : ℕ} {E F : Set (Bond d)} (hEF : Disjoint E F) :
    Indep (bondMarkSigma E) (bondMarkSigma F) (bondMarkLaw d) := by
  have hcoord : iIndepFun (fun (e : Bond d) (ω : BondMarks d) => ω e) (bondMarkLaw d) :=
    iIndepFun_infinitePi (X := fun _ (u : unitInterval) => u) fun _ => measurable_id
  exact indep_iSup_of_disjoint (fun e => (measurable_pi_apply e).comap_le) hcoord.iIndep hEF

/-- Thresholding only uses the marks at bonds in the specified set. -/
theorem measurable_thresholdBondMarks_bondSigma {d : ℕ} (p : unitInterval)
    (E : Set (Bond d)) :
    @Measurable _ _ (bondMarkSigma E) (bondSigma E) (thresholdBondMarks p) := by
  apply measurable_iff_comap_le.mpr
  simp only [bondSigma, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  apply iSup₂_le
  intro e he
  have hcoord : @Measurable _ _ (bondMarkSigma E) _ (fun ω : BondMarks d => ω e) :=
    measurable_iff_comap_le.mpr (le_iSup_of_le e (le_iSup_of_le he le_rfl))
  exact ((measurable_markThreshold p).comp hcoord).comap_le

/-- A fixed collection of mark lower bounds depends only on those marks. -/
theorem measurableSet_bondMarksAbove_local {d : ℕ} (F : Finset (Bond d))
    (β : Bond d → unitInterval) : MeasurableSet[bondMarkSigma (F : Set (Bond d))]
      (bondMarksAbove F β) := by
  letI : MeasurableSpace (BondMarks d) := bondMarkSigma (F : Set (Bond d))
  have heq : bondMarksAbove F β = ⋂ e ∈ F, (fun ω : BondMarks d => ω e) ⁻¹' Set.Ioi (β e) := by
    ext ω
    simp only [bondMarksAbove, Set.mem_setOf_eq, Set.mem_iInter, Set.mem_preimage, Set.mem_Ioi]
  rw [heq]
  apply F.measurableSet_biInter
  intro e he
  have hcoord : Measurable (fun ω : BondMarks d => ω e) :=
    measurable_iff_comap_le.mpr (le_iSup_of_le e (le_iSup_of_le he le_rfl))
  exact measurableSet_Ioi.preimage hcoord

end Rigidity.Percolation
