import Rigidity.Percolation.BondRandomFaceContacts

/-!
# Reachable face contacts

A finite collection of face vertices reached through the base configuration
is a measurable random set of contacts.
-/

namespace Rigidity.Percolation

open LatticeProb.Percolation MeasureTheory ProbabilityTheory Rigidity.External
open scoped MeasureTheory

/-- The vertices in a finite set that are connected to the root inside a region. -/
noncomputable def reachableContacts {d : ℕ} (B : Set (Vertex d)) (root : Vertex d)
    (s : Finset (Vertex d)) (ω : Configuration d) : Finset (Vertex d) := by
  classical
  exact s.filter (fun x => (openIn ω B).Reachable root x)

/-- Membership in the contact set means membership in the face and connection
within the prescribed region. -/
theorem mem_reachableContacts {d : ℕ} (B : Set (Vertex d)) (root : Vertex d)
    (s : Finset (Vertex d)) (ω : Configuration d) (x : Vertex d) :
    x ∈ reachableContacts B root s ω ↔
      x ∈ s ∧ (openIn ω B).Reachable root x := by
  classical
  simp [reachableContacts]

/-- The reached subset of a finite set is measurable. -/
theorem measurable_reachableContacts {d : ℕ} (B : Set (Vertex d)) (root : Vertex d)
    (s : Finset (Vertex d)) : Measurable (reachableContacts B root s) := by
  classical
  apply measurable_finset_iff.mpr
  intro x
  simpa only [mem_reachableContacts] using
    (measurable_const.and (measurableSet_setOf.mp
      (measurableSet_openIn_reachable B root x)))

/-- Reached contacts in the base field are measurable with respect to the
sigma algebra generated by that field. -/
theorem measurable_base_reachableContacts {d : ℕ} (B : Set (Vertex d)) (root : Vertex d)
    (s : Finset (Vertex d)) :
    @Measurable _ _ (baseBondSigma d) _
      (fun ω => reachableContacts B root s (baseBondConfiguration ω)) := by
  exact (measurable_reachableContacts B root s).comp (comap_measurable _)

/-- A base-connected face contact has a fully open outward trial in the
added field. -/
def reachableFaceSeedSuccess {d : ℕ} (B : Set (Vertex d)) (root : Vertex d)
    (s : Finset (Vertex d)) (k : ℕ) (j : Fin d) (n : ℤ) :
    Set (Bond d → Bool × Bool) :=
  {ω | ∃ x ∈ s, (openIn (baseBondConfiguration ω) B).Reachable root x ∧
    addedBondConfiguration ω ∈ fullyOpenRegion (faceSeedTrial k j n x)}

/-- The event that a reachable contact has an open trial is measurable. -/
theorem measurableSet_reachableFaceSeedSuccess {d : ℕ} (B : Set (Vertex d))
    (root : Vertex d) (s : Finset (Vertex d)) (k : ℕ) (j : Fin d) (n : ℤ) :
    MeasurableSet (reachableFaceSeedSuccess B root s k j n) := by
  have hb : Measurable (@baseBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_fst.comp (measurable_pi_apply e)
  have ha : Measurable (@addedBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_snd.comp (measurable_pi_apply e)
  have heq : reachableFaceSeedSuccess B root s k j n =
      ⋃ x ∈ s, (baseBondConfiguration ⁻¹'
        {ω | (openIn ω B).Reachable root x}) ∩ (addedBondConfiguration ⁻¹'
          fullyOpenRegion (faceSeedTrial k j n x)) := by
    ext ω
    simp [reachableFaceSeedSuccess, and_left_comm]
  rw [heq]
  exact MeasurableSet.iUnion fun x => MeasurableSet.iUnion fun _ =>
    (hb (measurableSet_openIn_reachable B root x)).inter
      (ha (bondSigma_le (localBonds (faceSeedTrial k j n x)) _
        (measurableSet_fullyOpenRegion_localBond (faceSeedTrial k j n x))))

/-- If sufficiently many vertices of a finite face are base-connected to the
root, a geometric bound holds for finding an open outward trial. -/
theorem condExp_indicator_lower_of_reachable_face_contacts {d k m : ℕ} (hk : 0 < k)
    (q r : unitInterval) (B : Set (Vertex d)) (root : Vertex d)
    (s : Finset (Vertex d)) (j : Fin d) (n : ℤ)
    (hface : ∀ x ∈ s, x j = n) {G : Set (Bond d → Bool × Bool)}
    (hG : MeasurableSet G)
    (hcard : ∀ ω ∈ G, m * k ^ d ≤
      (reachableContacts B root s (baseBondConfiguration ω)).card) :
    ∀ᵐ ω ∂(bondPairLaw d q r).restrict G,
      1 - (1 - (r : ℝ) ^ ((k ^ d + 1) ^ 2)) ^ m ≤
        (bondPairLaw d q r)[(reachableFaceSeedSuccess B root s k j n).indicator
          (fun _ => (1 : ℝ)) | baseBondSigma d] ω := by
  apply condExp_indicator_lower_of_random_face_contacts hk q r j n
    (fun ω => reachableContacts B root s (baseBondConfiguration ω))
    (measurable_base_reachableContacts B root s) hG
    (measurableSet_reachableFaceSeedSuccess B root s k j n)
    (fun ω _ x hx => hface x ((mem_reachableContacts B root s _ x).mp hx).1) hcard
  intro ω x hx hopen
  exact ⟨x, ((mem_reachableContacts B root s _ x).mp hx).1,
    ((mem_reachableContacts B root s _ x).mp hx).2, hopen⟩

end Rigidity.Percolation
