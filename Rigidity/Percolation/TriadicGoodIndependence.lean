import Rigidity.Percolation.TriadicWellConnectedEdgeSigma
import LatticeProb.Prob.Percolation.LatticeBondProbability

/-!
# Independence of local good-cube events

Events determined by bonds in disjoint vertex regions are independent under
Bernoulli bond percolation. In particular, good cubes with disjoint concentric
threefold enlargements are independent.
-/

namespace Rigidity.Percolation

open LatticeProb.Percolation MeasureTheory ProbabilityTheory

/-- The bonds whose endpoints both lie in a vertex region. -/
def localBonds {d : ℕ} (U : Set (Vertex d)) : Set (Bond d) :=
  {e | ∀ x ∈ e.1, x ∈ U}

/-- The sigma algebra generated by the bond coordinates in a region. -/
abbrev localBondSigma {d : ℕ} (U : Set (Vertex d)) :
    MeasurableSpace (Configuration d) :=
  ⨆ e ∈ localBonds U, MeasurableSpace.comap (fun ω : Configuration d => ω e) inferInstance

/-- Each open adjacency event in a region is measurable in its bond sigma algebra. -/
theorem localEdgeSigma_le_localBondSigma {d : ℕ} (U : Set (Vertex d)) :
    localEdgeSigma U ≤ localBondSigma U := by
  classical
  apply MeasurableSpace.generateFrom_le
  rintro E ⟨x, hx, y, hy, rfl⟩
  by_cases hxy : (nearestNeighborGraph d).Adj x y
  · have he : bondOfAdjacent hxy ∈ localBonds U := by
      intro z hz
      rcases Sym2.mem_iff.mp hz with rfl | rfl <;> assumption
    have hmeas : Measurable[localBondSigma U] (fun ω : Configuration d =>
        ω (bondOfAdjacent hxy)) :=
      measurable_iff_comap_le.mpr (le_iSup_of_le (bondOfAdjacent hxy) (le_iSup_of_le he le_rfl))
    have heq : {ω : Configuration d | (openGraph ω).Adj x y} =
        (fun ω : Configuration d => ω (bondOfAdjacent hxy)) ⁻¹' {true} := by
      ext ω
      simp only [Set.mem_setOf_eq, Set.mem_preimage, Set.mem_singleton_iff, openGraph_adj_iff]
      exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨hxy, h⟩⟩
    rw [heq]
    exact hmeas (measurableSet_singleton true)
  · have heq : {ω : Configuration d | (openGraph ω).Adj x y} = ∅ := by
      ext ω
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, openGraph_adj_iff]
      rintro ⟨h, _⟩
      exact hxy h
    rw [heq]
    exact @MeasurableSet.empty _ (localBondSigma U)

/-- Enlarging a vertex region enlarges its local bond sigma algebra. -/
theorem localBondSigma_mono {d : ℕ} {U V : Set (Vertex d)} (hUV : U ⊆ V) :
    localBondSigma U ≤ localBondSigma V := by
  refine iSup₂_le fun e he => ?_
  have he' : e ∈ localBonds V := fun x hx => hUV (he x hx)
  exact le_iSup_of_le e (le_iSup_of_le he' le_rfl)

/-- Disjoint vertex regions contain disjoint sets of internal bonds. -/
theorem disjoint_localBonds {d : ℕ} {U V : Set (Vertex d)} (hUV : Disjoint U V) :
    Disjoint (localBonds U) (localBonds V) := by
  rw [Set.disjoint_left]
  intro e heU heV
  obtain ⟨x, y, hxy, _⟩ := e.2
  have hx : x ∈ e.1 := hxy ▸ Sym2.mem_mk_left x y
  exact Set.disjoint_left.mp hUV (heU x hx) (heV x hx)

/-- Bond sigma algebras of disjoint vertex regions are independent. -/
theorem indep_localBondSigma {d : ℕ} (p : unitInterval) {U V : Set (Vertex d)}
    (hUV : Disjoint U V) :
    Indep (localBondSigma U) (localBondSigma V) (latticeBondLaw d p) :=
  indep_iSup_of_disjoint (fun e => (measurable_pi_apply e).comap_le)
    (latticeBondLaw_iIndepFun p).iIndep (disjoint_localBonds hUV)

/-- The sigma algebras of two families of local events are independent when
all regions in the first family are disjoint from all regions in the second. -/
theorem indep_iSup_localEdgeSigma {d : ℕ} {ι κ : Type*} (p : unitInterval)
    (U : ι → Set (Vertex d)) (V : κ → Set (Vertex d))
    (hUV : ∀ i j, Disjoint (U i) (V j)) :
    Indep (⨆ i, localEdgeSigma (U i)) (⨆ j, localEdgeSigma (V j))
      (latticeBondLaw d p) := by
  have hdisj : Disjoint (⋃ i, U i) (⋃ j, V j) := by
    rw [Set.disjoint_left]
    intro x hx hy
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hy
    exact Set.disjoint_left.mp (hUV i j) hi hj
  apply indep_of_indep_of_le (indep_localBondSigma p hdisj)
  · refine iSup_le fun i => (localEdgeSigma_le_localBondSigma (U i)).trans ?_
    exact localBondSigma_mono (Set.subset_iUnion U i)
  · refine iSup_le fun j => (localEdgeSigma_le_localBondSigma (V j)).trans ?_
    exact localBondSigma_mono (Set.subset_iUnion V j)

/-- Events measurable in disjoint local edge sigma algebras are independent. -/
theorem measure_inter_eq_mul_of_localEdge {d : ℕ} (p : unitInterval)
    {U V : Set (Vertex d)} (hUV : Disjoint U V) {A B : Set (Configuration d)}
    (hA : MeasurableSet[localEdgeSigma U] A) (hB : MeasurableSet[localEdgeSigma V] B) :
    latticeBondLaw d p (A ∩ B) = latticeBondLaw d p A * latticeBondLaw d p B := by
  exact (Indep_iff _ _ _).mp (indep_localBondSigma p hUV) A B
    (localEdgeSigma_le_localBondSigma U A hA) (localEdgeSigma_le_localBondSigma V B hB)

/-- Good-cube events with disjoint concentric threefold enlargements are independent. -/
theorem TriadicCube.measure_good_inter_eq_mul {d : ℕ} (p : unitInterval)
    (Q R : TriadicCube d) (interior : TriadicCube d → Set (Vertex d))
    (hinterior : ∀ T, interior T ⊆ T.vertices)
    (hQR : Disjoint Q.centeredTriple R.centeredTriple) :
    latticeBondLaw d p
      ({ω | Q ∈ goodOfWellConnected (wellConnectedFamily interior ω)} ∩
        {ω | R ∈ goodOfWellConnected (wellConnectedFamily interior ω)}) =
      latticeBondLaw d p {ω | Q ∈ goodOfWellConnected (wellConnectedFamily interior ω)} *
        latticeBondLaw d p {ω | R ∈ goodOfWellConnected (wellConnectedFamily interior ω)} :=
  measure_inter_eq_mul_of_localEdge p hQR
    (Q.measurableSet_goodOfWellConnected_localEdge interior hinterior)
    (R.measurableSet_goodOfWellConnected_localEdge interior hinterior)

/-- The sigma algebra generated by good-cube events in a family. -/
abbrev goodEventSigma {d : ℕ} {ι : Type*} (Q : ι → TriadicCube d)
    (interior : TriadicCube d → Set (Vertex d)) : MeasurableSpace (Configuration d) :=
  MeasurableSpace.generateFrom {E : Set (Configuration d) | ∃ i : ι, E =
    {ω : Configuration d | Q i ∈ TriadicCube.goodOfWellConnected
      (TriadicCube.wellConnectedFamily interior ω)}}

/-- Two families of good-cube events generate independent sigma algebras when
their threefold supports are pairwise disjoint across the families. -/
theorem indep_goodEventSigma {d : ℕ} {ι κ : Type*} (p : unitInterval)
    (Q : ι → TriadicCube d) (R : κ → TriadicCube d)
    (interior : TriadicCube d → Set (Vertex d))
    (hinterior : ∀ T, interior T ⊆ T.vertices)
    (hQR : ∀ i j, Disjoint (Q i).centeredTriple (R j).centeredTriple) :
    Indep (goodEventSigma Q interior) (goodEventSigma R interior) (latticeBondLaw d p) := by
  apply indep_of_indep_of_le
    (indep_iSup_localEdgeSigma p (fun i => (Q i).centeredTriple)
      (fun j => (R j).centeredTriple) hQR)
  · apply MeasurableSpace.generateFrom_le
    rintro E ⟨i, rfl⟩
    exact (le_iSup (fun i => localEdgeSigma (Q i).centeredTriple) i) _
      ((Q i).measurableSet_goodOfWellConnected_localEdge interior hinterior)
  · apply MeasurableSpace.generateFrom_le
    rintro E ⟨j, rfl⟩
    exact (le_iSup (fun j => localEdgeSigma (R j).centeredTriple) j) _
      ((R j).measurableSet_goodOfWellConnected_localEdge interior hinterior)

/-- A coordinate separation of the centers makes the threefold enlargements disjoint. -/
theorem TriadicCube.disjoint_centeredTriple_of_center_separation {d : ℕ}
    (Q R : TriadicCube d) (i : Fin d)
    (hsep : 3 * (Q.side + R.side) ≤ |2 * (Q.center i - R.center i)|) :
    Disjoint Q.centeredTriple R.centeredTriple := by
  rw [Set.disjoint_left]
  intro x hxQ hxR
  have hQ := abs_lt.mp (hxQ i)
  have hR := abs_lt.mp (hxR i)
  rcases le_abs.mp hsep with h | h <;> omega

/-- Failure events for good cubes with separated centers are independent. -/
theorem TriadicCube.measure_bad_inter_eq_mul_of_center_separation {d : ℕ}
    (p : unitInterval) (Q R : TriadicCube d)
    (interior : TriadicCube d → Set (Vertex d))
    (hinterior : ∀ T, interior T ⊆ T.vertices) (i : Fin d)
    (hsep : 3 * (Q.side + R.side) ≤ |2 * (Q.center i - R.center i)|) :
    latticeBondLaw d p
      ({ω | Q ∉ goodOfWellConnected (wellConnectedFamily interior ω)} ∩
        {ω | R ∉ goodOfWellConnected (wellConnectedFamily interior ω)}) =
      latticeBondLaw d p {ω | Q ∉ goodOfWellConnected (wellConnectedFamily interior ω)} *
        latticeBondLaw d p {ω | R ∉ goodOfWellConnected (wellConnectedFamily interior ω)} := by
  apply measure_inter_eq_mul_of_localEdge p (Q.disjoint_centeredTriple_of_center_separation R i hsep)
  · exact (Q.measurableSet_goodOfWellConnected_localEdge interior hinterior).compl
  · exact (R.measurableSet_goodOfWellConnected_localEdge interior hinterior).compl

end Rigidity.Percolation
