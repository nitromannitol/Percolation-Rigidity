import Rigidity.Percolation.SlabExploration
import Mathlib.Probability.ConditionalExpectation

/-!
# Fresh bonds in slab exploration

Disjoint bond families generate independent sigma algebras even when their
endpoint sets intersect. Events determined by fresh bonds therefore retain
their probabilities after conditioning on the previously exposed bonds.
-/

namespace Rigidity.Percolation

open LatticeProb.Percolation MeasureTheory ProbabilityTheory
open scoped MeasureTheory

/-- The sigma algebra generated by a specified family of bonds. -/
abbrev bondSigma {d : ℕ} (E : Set (Bond d)) : MeasurableSpace (Configuration d) :=
  ⨆ e ∈ E, MeasurableSpace.comap (fun ω : Configuration d => ω e) inferInstance

/-- Every bond-coordinate sigma algebra is contained in the configuration
sigma algebra. -/
theorem bondSigma_le {d : ℕ} (E : Set (Bond d)) :
    bondSigma E ≤ (inferInstance : MeasurableSpace (Configuration d)) :=
  iSup₂_le fun e _ => (measurable_pi_apply e).comap_le

/-- Disjoint bond families generate independent sigma algebras. -/
theorem indep_bondSigma {d : ℕ} (p : unitInterval) {E F : Set (Bond d)}
    (hEF : Disjoint E F) : Indep (bondSigma E) (bondSigma F) (latticeBondLaw d p) :=
  indep_iSup_of_disjoint (fun e => (measurable_pi_apply e).comap_le)
    (latticeBondLaw_iIndepFun p).iIndep hEF

/-- The conditional probability of an event determined by fresh bonds equals
its unconditional probability. -/
theorem condExp_indicator_eq_of_disjoint_bonds {d : ℕ} (p : unitInterval)
    {E F : Set (Bond d)} (hEF : Disjoint E F) {A : Set (Configuration d)}
    (hA : MeasurableSet[bondSigma E] A) :
    (latticeBondLaw d p)[A.indicator (fun _ => (1 : ℝ)) | bondSigma F] =ᵐ[latticeBondLaw d p]
      fun _ => (latticeBondLaw d p).real A := by
  have hstrong : StronglyMeasurable[bondSigma E] (A.indicator (fun _ => (1 : ℝ))) :=
    stronglyMeasurable_const.indicator hA
  have hind := condExp_indep_eq (bondSigma_le E) (bondSigma_le F) hstrong
    (indep_bondSigma p hEF)
  simpa only [integral_indicator_const (1 : ℝ) (bondSigma_le E _ hA), smul_eq_mul, mul_one] using hind


/-- A past-measurable choice of a fresh-bond event inherits a uniform lower
bound on its conditional probability. -/
theorem condExp_indicator_lower_of_fresh_bond_selection {d : ℕ} {ι : Type*}
    [Countable ι] (p : unitInterval) (F : Set (Bond d)) (E : ι → Set (Bond d))
    (hEF : ∀ i, Disjoint (E i) F) (A B : ι → Set (Configuration d))
    {G C : Set (Configuration d)} (hA : ∀ i, MeasurableSet[bondSigma F] (A i))
    (hB : ∀ i, MeasurableSet[bondSigma (E i)] (B i)) (hC : MeasurableSet C)
    (hG : MeasurableSet G) (hcover : G ⊆ ⋃ i, A i)
    (hsubset : ∀ i, A i ∩ B i ⊆ C) (δ : ℝ)
    (hprob : ∀ i, δ ≤ (latticeBondLaw d p).real (B i)) :
    ∀ᵐ ω ∂(latticeBondLaw d p).restrict G,
      δ ≤ (latticeBondLaw d p)[C.indicator (fun _ => (1 : ℝ)) | bondSigma F] ω := by
  apply condExp_indicator_lower_of_measurable_selection (latticeBondLaw d p)
    (bondSigma_le F) A B hA (fun i => bondSigma_le (E i) _ (hB i)) hC hG hcover hsubset δ
  intro i
  filter_upwards [condExp_indicator_eq_of_disjoint_bonds p (hEF i) (hB i)] with ω hω
  rw [hω]
  exact hprob i

end Rigidity.Percolation
