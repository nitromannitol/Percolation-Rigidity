import Rigidity.Percolation.BondSeeds
import Rigidity.Percolation.SlabFreshBonds

/-!
# Seed events in the sprinkling layer

Seed events in an independent sprinkling retain their probabilities after the
entire base configuration is revealed. This also applies to a countable choice
of a seed region determined by the base configuration.
-/

namespace Rigidity.Percolation

open LatticeProb.Percolation MeasureTheory ProbabilityTheory Rigidity.External
open scoped MeasureTheory

/-- An integer lattice rectangle has finitely many vertices. -/
theorem finite_latticeRectangle {d : ℕ} (lo hi : Vertex d) :
    (latticeRectangle lo hi).Finite := by
  simpa only [latticeRectangle, Set.mem_Ico] using
    (Set.Finite.pi' (fun i : Fin d => Set.finite_Ico (lo i) (hi i)))

/-- Every two vertices of a fully open lattice rectangle are connected inside it. -/
theorem reachable_openIn_rectangle_of_fullyOpenRegion {d : ℕ} {ω : Configuration d}
    (lo hi : Vertex d) (hseed : ω ∈ fullyOpenRegion (latticeRectangle lo hi))
    {x y : Vertex d} (hx : x ∈ latticeRectangle lo hi) (hy : y ∈ latticeRectangle lo hi) :
    (openIn ω (latticeRectangle lo hi)).Reachable x y :=
  reachable_openIn_of_fullyOpenRegion hseed (reachable_allOpen_latticeRectangle lo hi hx hy)

/-- A seed open in the added field is also open in the union field. -/
theorem sprinkled_fullyOpenRegion_of_added {d : ℕ} {ω : Bond d → Bool × Bool}
    {U : Set (Vertex d)} (hseed : addedBondConfiguration ω ∈ fullyOpenRegion U) :
    sprinkledBondConfiguration ω ∈ fullyOpenRegion U := by
  intro e he
  change ((ω e).1 || (ω e).2) = true
  have h := hseed e he
  change (ω e).2 = true at h
  simp [h]

/-- A rectangle opened by sprinkling is connected in the union field. -/
theorem reachable_sprinkled_rectangle_of_added_seed {d : ℕ}
    {ω : Bond d → Bool × Bool} (lo hi : Vertex d)
    (hseed : addedBondConfiguration ω ∈ fullyOpenRegion (latticeRectangle lo hi))
    {x y : Vertex d} (hx : x ∈ latticeRectangle lo hi) (hy : y ∈ latticeRectangle lo hi) :
    (openIn (sprinkledBondConfiguration ω) (latticeRectangle lo hi)).Reachable x y :=
  reachable_openIn_rectangle_of_fullyOpenRegion lo hi
    (sprinkled_fullyOpenRegion_of_added hseed) hx hy

/-- The sigma algebra generated by the base configuration. -/
abbrev baseBondSigma (d : ℕ) : MeasurableSpace (Bond d → Bool × Bool) :=
  MeasurableSpace.comap baseBondConfiguration inferInstance

/-- The sigma algebra generated by the sprinkling configuration. -/
abbrev addedBondSigma (d : ℕ) : MeasurableSpace (Bond d → Bool × Bool) :=
  MeasurableSpace.comap addedBondConfiguration inferInstance

/-- The conditional probability of an added-layer seed given the base field
equals its unconditional probability. -/
theorem condExp_indicator_added_seed (d : ℕ) (q r : unitInterval)
    (U : Set (Vertex d)) :
    (bondPairLaw d q r)[(addedBondConfiguration ⁻¹' fullyOpenRegion U).indicator
      (fun _ => (1 : ℝ)) | baseBondSigma d] =ᵐ[bondPairLaw d q r]
      fun _ => (latticeBondLaw d r).real (fullyOpenRegion U) := by
  have hbase : Measurable (@baseBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_fst.comp (measurable_pi_apply e)
  have hadd : Measurable (@addedBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_snd.comp (measurable_pi_apply e)
  have hseed : MeasurableSet (fullyOpenRegion U) :=
    bondSigma_le (localBonds U) _ (measurableSet_fullyOpenRegion_localBond U)
  have haddSeed : MeasurableSet[addedBondSigma d]
      (addedBondConfiguration ⁻¹' fullyOpenRegion U) :=
    MeasurableSpace.measurableSet_comap.mpr ⟨_, hseed, rfl⟩
  have hstrong : StronglyMeasurable[addedBondSigma d]
      ((addedBondConfiguration ⁻¹' fullyOpenRegion U).indicator (fun _ => (1 : ℝ))) :=
    stronglyMeasurable_const.indicator haddSeed
  haveI : IsProbabilityMeasure (bondPairLaw d q r) := by
    dsimp only [bondPairLaw]
    infer_instance
  have hind := condExp_indep_eq hadd.comap_le hbase.comap_le hstrong
    (bondPairLaw_indep_layers d q r).symm
  have hmeasure : (bondPairLaw d q r).real (addedBondConfiguration ⁻¹' fullyOpenRegion U) =
      (latticeBondLaw d r).real (fullyOpenRegion U) := by
    rw [measureReal_def, measureReal_def, ← Measure.map_apply hadd hseed, bondPairLaw_map_added]
  simpa only [integral_indicator_const (1 : ℝ) (hadd hseed), smul_eq_mul, mul_one, hmeasure]
    using hind

/-- A countable choice of seed region made from the base field inherits any
uniform lower bound on its sprinkling-layer seed probability. -/
theorem condExp_indicator_lower_of_base_seed_selection {d : ℕ} {ι : Type*}
    [Countable ι] (q r : unitInterval) (U : ι → Set (Vertex d))
    (A : ι → Set (Bond d → Bool × Bool)) {G C : Set (Bond d → Bool × Bool)}
    (hA : ∀ i, MeasurableSet[baseBondSigma d] (A i))
    (hG : MeasurableSet G) (hC : MeasurableSet C) (hcover : G ⊆ ⋃ i, A i)
    (hsubset : ∀ i, A i ∩ (addedBondConfiguration ⁻¹' fullyOpenRegion (U i)) ⊆ C)
    (δ : ℝ) (hprob : ∀ i, δ ≤ (latticeBondLaw d r).real (fullyOpenRegion (U i))) :
    ∀ᵐ ω ∂(bondPairLaw d q r).restrict G,
      δ ≤ (bondPairLaw d q r)[C.indicator (fun _ => (1 : ℝ)) | baseBondSigma d] ω := by
  have hbase : Measurable (@baseBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_fst.comp (measurable_pi_apply e)
  have hadd : Measurable (@addedBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_snd.comp (measurable_pi_apply e)
  haveI : IsProbabilityMeasure (bondPairLaw d q r) := by
    dsimp only [bondPairLaw]
    infer_instance
  apply condExp_indicator_lower_of_measurable_selection (bondPairLaw d q r)
    hbase.comap_le A (fun i => addedBondConfiguration ⁻¹' fullyOpenRegion (U i)) hA
    (fun i => hadd (bondSigma_le (localBonds (U i)) _
      (measurableSet_fullyOpenRegion_localBond (U i)))) hC hG hcover hsubset δ
  intro i
  filter_upwards [condExp_indicator_added_seed d q r (U i)] with ω hω
  rw [hω]
  exact hprob i

/-- Uniformly bounded finite seeds chosen from the base field have an explicit
positive conditional probability at positive sprinkling density. -/
theorem condExp_indicator_lower_of_bounded_base_seed_selection {d : ℕ} {ι : Type*}
    [Countable ι] (q r : unitInterval) (U : ι → Set (Vertex d))
    (hU : ∀ i, (U i).Finite) (N : ℕ)
    (hN : ∀ i, (finite_localBonds (hU i)).toFinset.card ≤ N)
    (A : ι → Set (Bond d → Bool × Bool)) {G C : Set (Bond d → Bool × Bool)}
    (hA : ∀ i, MeasurableSet[baseBondSigma d] (A i))
    (hG : MeasurableSet G) (hC : MeasurableSet C) (hcover : G ⊆ ⋃ i, A i)
    (hsubset : ∀ i, A i ∩ (addedBondConfiguration ⁻¹' fullyOpenRegion (U i)) ⊆ C) :
    ∀ᵐ ω ∂(bondPairLaw d q r).restrict G,
      (r : ℝ) ^ N ≤
        (bondPairLaw d q r)[C.indicator (fun _ => (1 : ℝ)) | baseBondSigma d] ω :=
  condExp_indicator_lower_of_base_seed_selection q r U A hA hG hC hcover hsubset
    ((r : ℝ) ^ N) (fun i => latticeBondLaw_real_fullyOpenRegion_lower r (U i) (hU i) N (hN i))

/-- For a rectangle and two of its vertices chosen from the base field, a
uniform bound on its internal bonds gives a conditional lower bound for their
connection in the sprinkled field. -/
theorem condExp_indicator_lower_of_base_rectangle_selection {d : ℕ} {ι : Type*}
    [Countable ι] (q r : unitInterval) (lo hi x y : ι → Vertex d)
    (N : ℕ) (hN : ∀ i,
      (finite_localBonds (finite_latticeRectangle (lo i) (hi i))).toFinset.card ≤ N)
    (hx : ∀ i, x i ∈ latticeRectangle (lo i) (hi i))
    (hy : ∀ i, y i ∈ latticeRectangle (lo i) (hi i))
    (A : ι → Set (Bond d → Bool × Bool)) {G : Set (Bond d → Bool × Bool)}
    (hA : ∀ i, MeasurableSet[baseBondSigma d] (A i))
    (hG : MeasurableSet G) (hcover : G ⊆ ⋃ i, A i) :
    ∀ᵐ ω ∂(bondPairLaw d q r).restrict G,
      (r : ℝ) ^ N ≤ (bondPairLaw d q r)[(⋃ i, A i ∩ {ω | (openIn (sprinkledBondConfiguration ω)
          (latticeRectangle (lo i) (hi i))).Reachable (x i) (y i)}).indicator
          (fun _ => (1 : ℝ)) | baseBondSigma d] ω := by
  have hbase : Measurable (@baseBondConfiguration d) := by
    apply measurable_pi_lambda
    intro e
    exact measurable_fst.comp (measurable_pi_apply e)
  have hsprinkle : Measurable (@sprinkledBondConfiguration d) := by
    change Measurable (fun ω : Bond d → Bool × Bool => fun e => (ω e).1 || (ω e).2)
    fun_prop
  have hC : MeasurableSet (⋃ i, A i ∩ {ω | (openIn (sprinkledBondConfiguration ω)
      (latticeRectangle (lo i) (hi i))).Reachable (x i) (y i)}) := by
    apply MeasurableSet.iUnion
    intro i
    exact (hbase.comap_le _ (hA i)).inter
      (hsprinkle (measurableSet_openIn_reachable _ _ _))
  apply condExp_indicator_lower_of_bounded_base_seed_selection q r
    (fun i => latticeRectangle (lo i) (hi i))
    (fun i => finite_latticeRectangle (lo i) (hi i)) N hN A hA hG hC hcover
  intro i ω hω
  refine Set.mem_iUnion.mpr ⟨i, hω.1, ?_⟩
  exact reachable_sprinkled_rectangle_of_added_seed (lo i) (hi i) hω.2 (hx i) (hy i)

end Rigidity.Percolation
